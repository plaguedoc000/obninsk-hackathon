# Скопируйте в .env и заполните. Файл .env не попадает в git.
# На сервере тот же файл лежит в /srv/app/.env

# Нейросеть: gigachat | yandex | openai | пусто (заглушка без ИИ)
LLM_PROVIDER=

# GigaChat: developers.sber.ru → GigaChat API → «Ключ авторизации»
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Путь к корневому сертификату Минцифры; без него TLS не проверяется
GIGACHAT_CA_BUNDLE=

# YandexGPT: Yandex Cloud → сервисный аккаунт → API-ключ, плюс ID каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# Любой OpenAI-совместимый API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Вход через Флида ID: id.flida.ru → Мои проекты → проект → Ключи → Client ID.
# Там же в «Платформы → Web» добавьте Redirect URL https://31-77-173-151.sslip.io/
# (для разработки ещё http://localhost:5173/). Client Secret не нужен
FLIDA_CLIENT_ID=
