# Скопируйте в .env и заполните. Файл .env не попадает в git.
# На сервере тот же файл лежит в /srv/app/.env

# Нейросеть: gigachat | yandex | openai | пусто (заглушка без ИИ)
LLM_PROVIDER=

# GigaChat: developers.sber.ru → GigaChat API → «Ключ авторизации»
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Путь к корневому сертификату Минцифры; без него TLS не проверяется
GIGACHAT_CA_BUNDLE=

# YandexGPT: Yandex Cloud → сервисный аккаунт → API-ключ, плюс ID каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# Любой OpenAI-совместимый API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Вход через Флида ID. По умолчанию — проект «Акулы хакатонов» (backend/app/config.py).
# Его Redirect URL: https://merakadr.ru/flida/oauth2/callback и http://localhost:3000/flida/oauth2/callback,
# поэтому вход работает только на merakadr.ru и при разработке на :3000. Client Secret не нужен
# FLIDA_CLIENT_ID=
